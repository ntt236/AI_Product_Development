# ========================================================
# AI English Learning Platform - Environment Configuration
# ========================================================
# Copy this file to .env.local and fill in the actual values.
# NEVER commit .env.local or any real secrets to version control.

# Supabase Configuration
# Client & Server accessible (Anon Key hoặc Publishable Key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-placeholder
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-placeholder

# Server-only Administrative Key (DO NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# AI Provider Configuration (Phase 5+)
# Supported options: 'gemini' | 'openai'
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-placeholder
OPENAI_API_KEY=your-openai-api-key-placeholder
